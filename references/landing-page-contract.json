{
  "schemaVersion": 1,
  "target": "landing_page_definition",
  "definitionFile": "assets/landing-page.json",
  "landingPage": {
    "capabilityPreview": {
      "optional": true,
      "fields": ["enabled", "commandTrigger"],
      "additionalProperties": false,
      "commandType": "operator_action",
      "requiresWorkflowRef": true,
      "requiresWorkflowSkill": true,
      "journeyPackageSchemaVersion": 2,
      "journeyOwner": "committed_workflow_repository",
      "copyOwner": "workflow_package_generated_locale_catalogue",
      "supportedPlacements": ["default_hero", "cinematic-campaigns", "form-operations", "grocery-twin", "recruiting-operations"],
      "preserveLandingPageSchemaVersion": 2,
      "noExecutableOrProviderFields": true,
      "activationRequiresCompatibleBackendAndAcceptance": true
    },
    "fields": [
      { "key": "headline", "type": "text", "required": true },
      { "key": "subheadline", "type": "text", "required": false },
      { "key": "ctaLabel", "type": "text", "required": false }
    ],
    "localization": {
      "optional": true,
      "optionalForBackwardCompatibility": true,
      "requiredForNewLandingPages": true,
      "schemaVersion": 2,
      "translation": {
        "createDefault": {
          "enabled": true,
          "sourceLanguage": "en",
          "defaultLanguage": "en",
          "autoDetectCountryLanguage": true,
          "generatedTranslations": []
        },
        "fields": ["enabled", "sourceLanguage", "defaultLanguage", "autoDetectCountryLanguage", "generatedTranslations"],
        "languageCatalogue": "shared",
        "countryLanguageSource": "cldr_likely_subtags",
        "autoDetectCountryLanguageDefault": true,
        "generatedTranslationStorage": {
          "mode": "source_revisioned_per_language_git_json",
          "servedBeforeGeneration": true,
          "consumesVisitorQuota": false,
          "manifestFields": ["language", "regionKey", "sourceRevision", "assetPath", "assetSchemaVersion", "generatedAt"],
          "assetSchemaVersion": 2,
          "assetFields": ["schemaVersion", "language", "regionKey", "sourceRevision", "landingPage", "chatEmbedConfig", "translationIndex", "generatedAt"],
          "translationIndexFields": ["path", "sourceHash"],
          "staleAssetPolicy": "rebase_matching_path_and_source_hash_then_translate_delta",
          "defaultAssetPattern": "assets/landing-page.<language>.json",
          "regionalAssetPattern": "assets/landing-page.<regionKey>.<language>.json",
          "legacyInlinePageReadCompatible": true,
          "newWritesRequireAssetPath": true,
          "newWritesAllowInlinePage": false,
          "aggregateTranslationFileAllowed": false,
          "sourceLanguageAssetAllowed": false,
          "lazyLoadSelectedAssetOnly": true
        },
        "publicDistinctTargetLimit": 3,
        "windowHours": 24,
        "quotaAuthorConfigurable": false
      },
      "regionalPages": {
        "fields": ["key", "label", "countryCodes", "defaultLanguage", "page"],
        "countryCodeFormat": "uppercase_iso_3166_1_alpha_2",
        "uniqueRegionKeys": true,
        "uniqueCountryAssignments": true,
        "pageMode": "complete_clone",
        "allowDifferentRegisteredTheme": true,
        "nestedLocalization": false,
        "routingSource": "server_request_ip_country"
      }
    },
    "featureItem": {
      "fields": [
        { "key": "icon", "type": "text", "required": false, "description": "One of the allowed icon tokens — see SKILL.md" },
        { "key": "title", "type": "text", "required": true },
        { "key": "body", "type": "text", "required": true }
      ]
    },
    "formOperations": {
      "requiredWhen": { "design.variant": "form-operations" },
      "sections": [
        "heroDemo",
        "proofItems",
        "principle",
        "impact",
        "process",
        "useCases",
        "workedExample",
        "control",
        "leadCapture",
        "footer"
      ],
      "constraints": {
        "traceState": ["done", "active", "pending"],
        "actor": ["persona", "human"],
        "useCaseStatus": ["live", "next", "custom"],
        "percentageRange": [0, 100],
        "captureAndFill": {
          "optional": true,
          "requires": ["enabled", "commandTrigger"],
          "runtimeLimits": "platform_controlled"
        },
        "optionalFooterFields": ["poweredBy", "closingStatement", "copyright"]
      }
    },
    "logisticsPortal": {
      "requiredWhen": { "design.variant": "logistics-portal" },
      "sections": ["header", "hero", "ticker", "edge", "platform", "process", "workflows", "pilot", "footer"],
      "constraints": {
        "navigationItems": 3,
        "proofItems": 3,
        "heroSuggestions": 3,
        "workflowTabs": ["customs", "carrier"],
        "simulationSamples": 2,
        "intakeSteps": 4,
        "reviewExceptionsPerSample": 3,
        "capabilityCards": 4,
        "processSteps": 6,
        "processStepMedia": ["image", "alt"],
        "primaryWorkflows": 2,
        "secondaryWorkflows": 4,
        "pilotSteps": 3,
        "rehearsal": {
          "requires": ["enabled", "commandTrigger"],
          "commandExecutionType": "operator_action",
          "workflowResourceKey": "workflow.emil.rehearse-filing",
          "anonymousRuntime": "illustrative_only"
        },
        "runtimeDataPolicy": "definitions_only"
      }
    },
    "cinematicCampaigns": {
      "requiredWhen": { "design.variant": "cinematic-campaigns" },
      "sections": [
        "hero",
        "workflow",
        "delivery",
        "showcase",
        "features",
        "tracker",
        "meetArcher",
        "fit",
        "pilot",
        "footer"
      ],
      "constraints": {
        "navigationItems": 5,
        "heroHeadingLines": 2,
        "intakeSuggestions": 3,
        "workflowSteps": 3,
        "workflowKinds": ["send", "brand", "approve"],
        "deliveryPlatforms": ["instagram-reels", "tiktok", "youtube-shorts", "snapchat"],
        "deliveryAspectRatio": "9:16",
        "showcasePlaceholders": 3,
        "featureItems": 6,
        "trackerStatuses": ["footage-received", "in-production", "pending-approval", "approved", "delivered"],
        "trackerBenefits": 3,
        "meetArcherPoints": 3,
        "meetArcherVoiceCtaLabel": { "optional": true, "type": "string", "minLength": 1, "maxLength": 80, "action": "confirm_public_voice_demo" },
        "instagramCampaign": {
          "path": "hero.instagramCampaign",
          "requires": ["enabled", "commandTrigger", "localizedUiCopy"],
          "localizedUiCopyIncludes": ["welcomeMessage", "urlRequestMessage", "brandAndTypographyLabels", "imageFormatLabels", "errorGroups", "claimTranscriptMessages", "sourceReview"],
          "sourceReview": { "optionalForLegacy": true, "copyOnly": true, "maxStringLength": 600, "permissionRequired": true, "permissionQuestionToken": "{accountName}", "changeAccountLabel": "localized copy", "limitationCodes": ["login_wall", "private_content", "captcha", "thumbnails_only", "captions_unavailable", "media_unavailable", "time_limit"] },
          "commandTrigger": "instagram-campaign",
          "commandExecutionType": "operator_action",
          "workflowResourceKey": "workflow.archer.instagram-campaign-v2",
          "publicStages": ["brand_review", "event_brief", "image_review", "confirmed"],
          "anonymousRuntime": "three_images_then_authentication",
          "limitsOwnedBy": "platform"
        },
        "accessibilityCopy": {
          "path": "accessibility",
          "requires": ["mainNavigationLabel", "previousPreviewLabel", "nextPreviewLabel", "pausePreviewsLabel", "resumePreviewsLabel"]
        },
        "headerCta": { "labelField": "header.ctaLabel", "target": "meet-archer" },
        "fitItems": 3,
        "pilotSteps": 3,
        "optionalSectionVisibility": {
          "fields": ["fit.showSection", "pilot.showSection"],
          "type": "boolean",
          "default": true,
          "hiddenNavigation": "filtered",
          "hiddenPilotCtas": "booking_url"
        },
        "bookingUrlProtocol": "https",
        "generatedMediaRequired": false,
        "optionalPresentationMedia": {
          "noticeRequired": true,
          "purpose": "decorative cinematic presentation, never client proof",
          "urlProtocol": "https",
          "heroVideo": 1,
          "videoPostersRequired": true,
          "workflowThumbnails": 3,
          "workflowImage": 1,
          "showcaseVideos": 3,
          "showcaseMediaKinds": ["image", "video"],
          "showcaseImagePurpose": "clearly labelled static start-frame placeholder until a matching motion clip is supplied",
          "featureMedia": 7,
          "featureMediaKinds": ["image", "video"],
          "workspaceBackground": 1,
          "workspaceProjects": 3,
          "filmstrip": 5,
          "fitImages": 2
        },
        "runtimeDataPolicy": "definitions_only"
      }
    },
    "recruitingOperations": {
      "requiredWhen": { "design.variant": "recruiting-operations" },
      "sections": ["hero", "features", "workflow", "comparison", "leads", "pillars", "principles", "faq", "closing", "footer"],
      "constraints": {
        "navigationItems": 4,
        "heroSignals": 3,
        "featureItems": 4,
        "activityItems": 4,
        "manualSteps": 5,
        "personaSteps": 4,
        "leadRows": 4,
        "pillarItems": 5,
        "principleItems": 3,
        "faqItems": 5,
        "commandExecutionType": "operator_action",
        "runtimeDataPolicy": "definitions_only"
      }
    },
    "groceryTwin": {
      "requiredWhen": { "design.variant": "grocery-twin" },
      "homeRoiCalculator": {
        "optional": true,
        "contract": "roiCalculator",
        "recommendedMethodologyVersion": 2,
        "placement": "home_only",
        "retailCalculatorPath": "landingPage.roiCalculator",
        "fallbackToRetail": false
      },
      "sections": ["header", "hero", "product", "mobile", "features", "stories", "about", "closing", "footer"],
      "constraints": {
        "navigationItems": 5,
        "trustItems": 4,
        "heroSuggestions": 3,
        "productCapabilities": 6,
        "productCards": 3,
        "mobileItems": 4,
        "featureItems": 3,
        "testimonials": 6,
        "storyItems": 3,
        "aboutCapabilities": 9,
        "heroDemo": {
          "requires": ["enabled", "commandTrigger"],
          "commandExecutionType": "operator_action",
          "attachmentInputKey": "inventory_photos",
          "runtimeLimits": "platform_controlled"
        },
        "runtimeDataPolicy": "definitions_only"
      }
    },
    "eventIntroductions": {
      "requiredWhen": { "design.variant": "event-introductions" },
      "sections": ["header", "event", "tracks", "hero", "about", "process", "pairing", "faq", "waitlist", "closing", "footer"],
      "constraints": {
        "navigationItems": 5,
        "tracks": ["founder-investor", "founder-cofounder", "startup-startup"],
        "briefFields": ["organization", "role", "currentEvent", "goal", "offer", "need", "fitCriteria", "availability", "privateConstraints"],
        "aboutImages": 3,
        "principles": 3,
        "processSteps": 4,
        "pairingImages": 2,
        "pairingCards": 3,
        "faqItems": 6,
        "heroDemo": {
          "requires": ["enabled", "commandTrigger"],
          "commandExecutionType": "operator_action",
          "anonymousRuntime": "brief_only",
          "runtimeLimits": "platform_controlled"
        },
        "runtimeDataPolicy": "definitions_only"
      }
    },
    "homeIntroductions": {
      "requiredWhen": { "design.variant": "home-introductions" },
      "sections": ["header", "service", "tracks", "hero", "audience", "privacy", "process", "proposals", "meet", "footer"],
      "constraints": {
        "navigationItems": 3,
        "serviceModes": ["event", "city"],
        "tracks": ["buying", "selling"],
        "trackFields": ["id", "label", "responseMessage", "composerPlaceholder", "processSteps", "briefFields"],
        "briefFields": ["serviceMode", "area", "propertyType", "propertyBrief", "budgetOrPrice", "mustHavesOrHighlights", "dealbreakersOrBuyerCriteria", "timing", "readiness", "privateConstraints"],
        "privacyStages": ["proposed", "accepted", "confirmed"],
        "processStepsPerTrack": 3,
        "processStepMedia": ["image", "alt"],
        "proposalCards": 3,
        "requiredDisclaimers": ["not a broker", "not a real estate agent", "not a valuer", "not a negotiator"],
        "heroDemo": {
          "requires": ["enabled", "commandTrigger"],
          "commandExecutionType": "operator_action",
          "anonymousRuntime": "brief_only",
          "runtimeLimits": "platform_controlled"
        },
        "runtimeDataPolicy": "definitions_only"
      }
    },
    "roiCalculator": {
      "optional": true,
      "optionalForBackwardCompatibility": true,
      "sectionId": "persona-landing-roi-calculator",
      "navTarget": "roi-calculator",
      "navLabel": "ROI Calculator",
      "guidedMethodology": {
        "methodologyVersion": 2,
        "reference": "references/business-impact.md",
        "navLabelSource": "businessImpact.copy.navLabel",
        "presentation": "three_steps_live_summary",
        "steps": ["workload", "operating_cost", "capacity_use"],
        "requiredFields": ["heading", "disclaimer", "currency", "inputs", "metrics", "businessImpact"],
        "businessImpactFields": ["defaults", "copy", "fields", "outcomes", "burden", "opportunity"],
        "workloadDefaultFields": ["volume", "minutes", "automation", "review"],
        "outcomeIds": ["cash", "higher_value", "throughput", "hiring", "error", "risk", "cycle_time"],
        "financialDefaults": false,
        "authoredFormulas": false,
        "compatibilityArrays": { "inputs": [], "metrics": [] },
        "unsetIsNotZero": true,
        "allocationsCannotExceedCapacity": true,
        "existingTeamReviewReducesCapacity": true,
        "paidReviewInCostOnce": true,
        "annualGrowth": false,
        "hiringDurationMonths": [1, 12],
        "validator": "scripts/business-impact.cjs",
        "scaffold": "scripts/create-business-impact.cjs"
      },
      "navInjection": "renderer_owned_when_enabled",
      "methodology": {
        "layers": ["economics", "operations", "value"],
        "productivity": ["negative", "positive"],
        "valueClasses": [
          "cost-elimination", "capacity-creation", "revenue-productivity", "error-avoidance",
          "risk-reduction", "throughput", "hiring-avoidance", "cycle-time"
        ],
        "return": "economic_value / all_in_ai_cost",
        "hoursAreCapacity": true
      },
      "requiredFields": ["heading", "disclaimer", "currency", "inputs", "metrics"],
      "nonTranslatableFields": [
        "formula", "currency", "locale", "format", "kind", "defaultPeriod", "defaultScenarioId",
        "costMetricId", "benefitMetricId", "primaryTarget", "secondaryTarget", "methodologyVersion", "min", "max", "step", "defaultValue",
        "multiplier", "months", "scalesWithPeriod", "scalesWithScenario", "enabled", "periodToggle",
        "profile", "profileIcon", "id", "type", "group", "layer", "valueClass", "productivity"
      ],
      "formulaDsl": {
        "operators": ["+", "-", "*", "/", "(", ")"],
        "builtins": ["scenario", "period_months", "weeks_per_month"],
        "identifierPattern": "^[a-z][a-z0-9_]{0,47}$",
        "eval": false
      },
      "inputTypes": ["slider", "number", "select"],
      "inputGroups": ["profile", "workload", "economics", "allocation"],
      "formats": ["number", "integer", "currency", "hours", "percent", "multiplier", "tokens"],
      "metricKinds": ["card", "breakdown-benefit", "breakdown-cost", "summary-cost", "summary-roi", "summary-benefit", "hidden"],
      "metricLayers": ["economics", "operations", "value"],
      "periods": ["monthly", "yearly"]
    }
  }
}
