    "roiCalculator": {
      "enabled": false,
      "kicker": "AI economics",
      "heading": "ROI Calculator",
      "subheading": "Hours not spent chasing lists are capacity. Value them by whether they become more introductions, better matching, or real cost you stop paying.",
