    "faqs": [
      {
        "question": "Is Juno a dating app?",
        "answer": "Not really. There is no swipe deck or public profile. You tell Juno who you are and what you want, and he makes one thoughtful introduction at a time."
      },
      {
        "question": "Will everyone see my profile?",
        "answer": "No. Your profile is private by default. Juno only shares an approved introduction with someone he thinks could be a fit, never in a public or searchable feed."
      },
      {
        "question": "What if I'm not interested in a match?",
        "answer": "Just tell Juno. Declining never penalizes you or the other person, and he'll keep looking until it's right."
      },
      {
        "question": "Is Juno free to use?",
        "answer": "Yes, chatting with Juno and getting introductions is free."
      }
    ],
